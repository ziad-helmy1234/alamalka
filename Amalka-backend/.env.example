# ─────────────────────────── Server ───────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS / WebSocket (mobile apps need none)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies (load balancer, nginx) in front of the API
TRUST_PROXY=0

# ─────────────────────────── Data stores ───────────────────────────
# Matches docker-compose.yml (Postgres published on host port 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql://amalka:amalka_dev_password@localhost:5433/amalka?schema=public
REDIS_URL=redis://localhost:6380

# ─────────────────────────── Auth ───────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=amalka-backend
JWT_AUDIENCE=amalka-app
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ─────────────────────────── Rate limits (per minute) ───────────────────────────
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ORDERS_PER_MIN=60

# ─────────────────────────── Trading rules ───────────────────────────
# Commission + exchange fees as a fraction of trade value (0.002 = 0.2%). Set to your broker's schedule.
TRADING_FEE_RATE=0.002
# Extra buying power reserved for MARKET buys (0.05 = 5%)
MARKET_BUY_BUFFER=0.05
# Daily price limit around previous close (0.2 = ±20%). Confirm current EGX limits with your broker.
PRICE_BAND_PCT=0.2
MAX_ORDER_QUANTITY=10000000
CUSTODIAN_BANKS=CIB Custody,NBE Custody,Banque Misr Custody,HSBC Custody,QNB Custody

# EGX session (Cairo time, Sunday=0 … Thursday=4)
MARKET_TIMEZONE=Africa/Cairo
MARKET_OPEN=10:00
MARKET_CLOSE=14:30
MARKET_DAYS=0,1,2,3,4
# true in production: rejects MARKET/FOK/FAK and pauses execution outside the session
ENFORCE_MARKET_HOURS=false

# ─────────────────────────── Market data ───────────────────────────
# simulator = built-in random-walk feed + simulated execution venue (development / demo)
# none      = no feed (plug in your licensed EGX data vendor + broker API)
MARKET_FEED=simulator
MARKET_TICK_MS=1500

# ─────────────────────────── Payments ───────────────────────────
# Public URL the gateways call back (must be HTTPS in production; use ngrok for local testing)
PUBLIC_BASE_URL=http://localhost:4000
APP_RETURN_URL=amalka://payments/result
MIN_DEPOSIT=10
MAX_DEPOSIT=1000000
PAYMENT_PROVIDER=paymob

# Paymob (Dashboard → Settings → Account info / Payment integrations)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=

# PayTabs (Egypt region)
PAYTABS_BASE_URL=https://secure-egypt.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# ─────────────────────────── Docs ───────────────────────────
SWAGGER_ENABLED=true
